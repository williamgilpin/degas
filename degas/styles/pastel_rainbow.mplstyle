# Paper-figure style with the 12-color degas pastel rainbow color cycle.
# Shares full high-contrast black box, outward ticks, larger Helvetica axis labels,
# frameless legends, and editable transparent exports with degas_figure.mplstyle.

lines.linewidth: 1.5
lines.antialiased: True

patch.linewidth: 0.0
patch.edgecolor: none
patch.force_edgecolor: False
patch.antialiased: True

font.family: sans-serif
font.sans-serif: Helvetica, Helvetica Neue, Arial, Open Sans, DejaVu Sans, sans-serif
font.size: 10.0
mathtext.default: regular

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none

text.color: 000000

axes.edgecolor: 000000
axes.linewidth: 0.75
axes.spines.top: True
axes.spines.right: True
axes.grid: False
axes.labelsize: 12.0
axes.labelpad: 6.0
axes.titlesize: 12.0
axes.labelcolor: 000000
# degas pastel rainbow color scheme (degas.pastel_rainbow)
axes.prop_cycle: cycler("color", ["DD3B35", "ED9D3F", "A5B485", "3F946D", "327A89", "2C73B2", "2B347C", "A4247C", "BAADD6", "A3DA85", "889F7A", "A8C0DD"])
axes.xmargin: 0.01
axes.ymargin: 0.01

xtick.direction: out
xtick.major.size: 3.5
xtick.minor.size: 2.0
xtick.major.width: 0.75
xtick.minor.width: 0.6
xtick.color: 000000
xtick.labelcolor: 000000
xtick.labelsize: 10.0

ytick.direction: out
ytick.major.size: 3.5
ytick.minor.size: 2.0
ytick.major.width: 0.75
ytick.minor.width: 0.6
ytick.color: 000000
ytick.labelcolor: 000000
ytick.labelsize: 10.0

legend.frameon: False

figure.figsize: 2, 2

savefig.transparent: True
savefig.dpi: 300

image.interpolation: nearest
image.cmap: vernalis
image.origin: lower
