# Paper-figure style for degas (manuscripts, multi-panel publication figures).
# High-contrast black full square box, outward ticks, larger Helvetica axis labels,
# frameless legends, borderless scatter/bars, and editable transparent high-DPI exports.

lines.linewidth: 1.5
lines.markersize: 4.5
lines.antialiased: True

patch.linewidth: 0.0
patch.edgecolor: none
patch.force_edgecolor: False
patch.antialiased: True

scatter.edgecolors: none
hist.bins: auto
errorbar.capsize: 0.0
pcolor.shading: auto
contour.linewidth: 1.0
contour.negative_linestyle: dashed

boxplot.showcaps: False
boxplot.boxprops.color: 000000
boxplot.boxprops.linewidth: 0.9
boxplot.whiskerprops.color: 000000
boxplot.whiskerprops.linewidth: 0.9
boxplot.medianprops.color: 000000
boxplot.medianprops.linewidth: 1.5
boxplot.flierprops.marker: o
boxplot.flierprops.markersize: 3.5
boxplot.flierprops.markerfacecolor: 000000
boxplot.flierprops.markeredgewidth: 0.0

font.family: sans-serif
font.sans-serif: Helvetica, Helvetica Neue, Arial, Open Sans, DejaVu Sans, sans-serif
font.size: 10.0
mathtext.default: regular

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none

text.color: 000000

axes.edgecolor: 000000
axes.linewidth: 0.75
axes.spines.top: True
axes.spines.right: True
axes.grid: False
axes.labelsize: 12.0
axes.labelpad: 6.0
axes.titlesize: 12.0
axes.labelcolor: 000000
axes.prop_cycle: cycler("color", [[0.372549, 0.596078, 1], [1.0, .3882, .2784], [0.20784314, 0.67843137, 0.6], [0.59607843, 0.25882353, 0.89019608],[0.803922, 0.0627451, 0.462745], [0.917647, 0.682353, 0.105882],[0.7, 0.7, 0.7]])
axes.xmargin: 0.01
axes.ymargin: 0.01

xtick.direction: out
xtick.major.size: 3.5
xtick.minor.size: 2.0
xtick.major.width: 0.75
xtick.minor.width: 0.6
xtick.color: 000000
xtick.labelcolor: 000000
xtick.labelsize: 10.0

ytick.direction: out
ytick.major.size: 3.5
ytick.minor.size: 2.0
ytick.major.width: 0.75
ytick.minor.width: 0.6
ytick.color: 000000
ytick.labelcolor: 000000
ytick.labelsize: 10.0

legend.frameon: False
legend.scatterpoints: 1
legend.numpoints: 1

figure.figsize: 2, 2

savefig.transparent: True
savefig.dpi: 300

image.interpolation: nearest
image.cmap: vernalis
image.origin: lower
