# Matplotlib defaults, plus degas shared base (Helvetica, vernalis, transparent export)
# and the degas high-contrast color cycle.

font.family: sans-serif
font.sans-serif: Helvetica, Helvetica Neue, Arial, Open Sans, DejaVu Sans, sans-serif
mathtext.default: regular

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none

image.cmap: vernalis

patch.edgecolor: none
patch.linewidth: 0.0
patch.force_edgecolor: False

scatter.edgecolors: none
hist.bins: auto
errorbar.capsize: 0.0
boxplot.showcaps: False
boxplot.flierprops.marker: o
boxplot.flierprops.markeredgewidth: 0.0
pcolor.shading: auto
contour.negative_linestyle: dashed

legend.frameon: False
legend.scatterpoints: 1
legend.numpoints: 1

savefig.transparent: True
savefig.dpi: 300

# degas high contrast color scheme (degas.high_contrast)
axes.prop_cycle: cycler("color", ["5F98FF", "FF6347", "35AD99", "9842E3", "CD1076", "EAAE1B", "B2B2B2"])
