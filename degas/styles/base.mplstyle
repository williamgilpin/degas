# Shared base defaults for all degas house styles.
# Applied automatically before specific styles by degas.set_style(), and can
# also be composed directly with plt.style.use([base, <style>]).

lines.antialiased: True
patch.antialiased: True
# Clean borderless bar/patch defaults (pair with width=0.64 or degas.plot_bar)
patch.edgecolor: none
patch.linewidth: 0.0
patch.force_edgecolor: False

# Prefer Helvetica when installed, falling back cleanly without font warnings
font.family: sans-serif
font.sans-serif: Helvetica, Helvetica Neue, Arial, Open Sans, DejaVu Sans, sans-serif
mathtext.default: regular

# Editable text in vector exports (Illustrator / Inkscape / journal submissions)
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none

axes.grid: False
legend.frameon: False

# Perceptually uniform default colormap (registered on `import degas`)
image.cmap: vernalis

# Transparent high-DPI exports by default (pair with degas.better_savefig)
savefig.transparent: True
savefig.dpi: 300
